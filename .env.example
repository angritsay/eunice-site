# Local development only. Every value has a default in compose.yaml, so
# `docker compose up` works without this file; copy it to .env to change one.
# Production values live in the deploy platform's secret store, never in a file.

# Postgres superuser (the container's own; no service uses it)
POSTGRES_PASSWORD=local-postgres
# intake: the schema owner (migrations) and the runtime role (the service)
INTAKE_OWNER_PASSWORD=local-intake-owner
INTAKE_APP_PASSWORD=local-intake-app

# sha256 of the bearer token for intake's admin endpoints. This one is
# sha256("local-dev-admin-token"); intake refuses it when SITE_ENV=production.
INTAKE_ADMIN_TOKEN_SHA256=aeba42a41f581015a9740bbe030b9fa50c34d8d12f7ea91912b99939ff4caac0

# Submissions per address per 10 minutes. Locally every request comes from one
# address, so the limit is raised; production uses intake's default of 5.
INTAKE_RATE_LIMIT_MAX=200

# Where the edge listens on your machine
EDGE_PORT=8080
