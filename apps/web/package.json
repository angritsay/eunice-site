{
  "name": "@eunice/web",
  "private": true,
  "type": "module",
  "description": "The eunice.ai site: a static generator, in TypeScript, whose output ships with no runtime dependencies",
  "scripts": {
    "build": "node build.ts",
    "preview": "node build.ts --preview",
    "serve": "node scripts/serve-dist.mjs",
    "test": "playwright test",
    "test:update": "UPDATE_GOLDEN=1 playwright test dom",
    "check:determinism": "node scripts/check-determinism.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "import:live": "node scripts/import-live.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  },
  "dependencies": {
    "@eunice/contracts": "workspace:*",
    "zod": "4.6.5"
  }
}
