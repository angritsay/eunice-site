{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/__golden__", "!**/generated", "!pnpm-lock.yaml"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Contradicts TypeScript's noPropertyAccessFromIndexSignature, which is the
        // stronger rule: env['PORT'] says in the code that the key may be missing.
        "useLiteralKeys": "off"
      }
    }
  },
  "overrides": [
    {
      // The generator and the site's own assets predate this config. They come under
      // it when they are rewritten: site.js and forms.js already have been (P2); the
      // rest of the generator follows in the TypeScript conversion (P7).
      "includes": ["apps/web/src/**", "!apps/web/src/assets/site.js", "!apps/web/src/forms.js", "apps/web/build.mjs"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ]
}
