{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // The shipped stylesheet and SVGs are assets: reformatting them would change the
    // bytes visitors download for no reason, so they keep the design team's layout.
    "includes": [
      "**",
      "!**/__golden__",
      "!**/generated",
      "!pnpm-lock.yaml",
      "!apps/web/src/assets/site.css",
      "!apps/web/src/assets/**/*.svg"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "overrides": [
    {
      // Copy imported word for word from eunice.ai (scripts/import-live.ts). A "here" link
      // inside a sentence meets WCAG 2.4.4 (purpose from context); rewording it would
      // change the live copy, which these fragments must not do.
      "includes": ["apps/web/src/content/**/*.html"],
      "linter": { "rules": { "a11y": { "noAmbiguousAnchorText": "off" } } }
    }
  ],
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Contradicts TypeScript's noPropertyAccessFromIndexSignature, which is the
        // stronger rule: env['PORT'] says in the code that the key may be missing.
        "useLiteralKeys": "off"
      }
    }
  }
}
