{
  "name": "@eunice/platform",
  "private": true,
  "type": "module",
  "description": "Runtime plumbing every service needs the same way: config, logging, tracing, errors, health, database, migrations, outbox",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./telemetry": "./src/telemetry.ts",
