          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Quote this when asking about a submission."
          },
          "status": {
            "type": "string",
            "enum": [
              "received"
            ]
          }
        },
        "required": [
          "id",
          "status"
        ]
      },
      "Problem": {
