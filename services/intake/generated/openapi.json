  "paths": {
    "/v1/submissions": {
      "post": {
        "tags": [
          "Submissions"
        ],
        "summary": "Submit a form",
        "description": "Stores a form submission and announces it to the rest of the system. Retrying with the same `Idempotency-Key` returns the original result instead of creating a second submission.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "A UUID generated when the form was opened. Reused on retry."
            },
            "required": true,
            "description": "A UUID generated when the form was opened. Reused on retry.",
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmissionRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Stored, or recognised as a retry of a stored submission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionAccepted"
                }
              }
            }
          },
          "400": {
            "description": "The submission did not validate. `errors` says which fields.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The Idempotency-Key was already used for a different submission.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many submissions from this address. See Retry-After.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/erasures": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Erase everything held for an email address",
        "description": "GDPR Art. 17. Deletes every submission, and any unpublished event, for the address.",
        "security": [
          {
